# Copiá este archivo como .env y completá tus datos. NUNCA lo subas a internet.

# --- Instagram (Meta) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
INSTAGRAM_API_MODE=instagram_login
GRAPH_VERSION=v26.0

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Tu negocio (cuanto más detallado, mejores publicaciones y respuestas) ---
DESCRIPCION_NEGOCIO=Empresa de colocación, pulido y plastificado de pisos de madera en [zona]. Tono: cercano y profesional.
WHATSAPP_NUMERO=

# --- Avisos por Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ajustes ---
ZONA_HORARIA=America/Argentina/Buenos_Aires
RESPUESTAS_AUTOMATICAS=no
MINUTOS_ENTRE_REVISIONES=5
MAX_PUBLICACIONES_POR_DIA=1

# --- Fotos: alojamiento en Cloudinary (gratis, cloudinary.com) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Estilo de las historias ---
NOMBRE_MARCA=
COLOR_MARCA=181,101,29
MAX_HISTORIAS_POR_DIA=3

# --- Modo sin IA: "si" = no necesita clave de Anthropic (textos por plantilla, mensajes los respondés vos) ---
MODO_SIN_IA=si
HASHTAGS=#pisosdemadera #pulidodepisos #plastificado #pisosdeparquet #decoracion #hogar
CIERRE_POST=Escribinos por DM o WhatsApp para consultar.
TEXTO_HISTORIA=Pulido y plastificado de pisos
CTA_HISTORIA=Consultanos por DM

# --- Piloto automático: una historia por día y un post por semana, sin pedir aprobación previa.
#     Te avisa por Telegram con la foto elegida; desde ahí podés pedir otra o saltearla. ---
AUTOPILOTO=si
HORA_HISTORIA=12
DIAS_AVISO_POST=2
# Podés poner varias frases separadas por | y se van turnando día a día:
# TEXTO_HISTORIA=Pulido y plastificado de pisos|Tu piso como nuevo|Trabajo terminado
# CTA_HISTORIA=Consultanos por DM|Pedí tu presupuesto por DM

# --- Google Drive: carpeta de donde el bot toma las fotos ---
DRIVE_CARPETA_ID=
GOOGLE_CREDENCIALES=credenciales_google.json
